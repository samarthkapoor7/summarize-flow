{
  "version": 2,
  "builds": [
    { "src": "api/index.cjs", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.cjs" },
    { "src": "/(.*\\.\\w+)$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}