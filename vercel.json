{
  "version": 2,
  "builds": [
    { "src": "api/index.cjs", "use": "@vercel/node" },
    { "src": "src/main.tsx", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.cjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}